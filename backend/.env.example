MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.hpeatzl.mongodb.net/moremess?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=<long random string>
PORT=5000
# Only needed if Node fails to resolve the mongodb+srv address (querySrv ECONNREFUSED).
DNS_SERVERS=8.8.8.8,1.1.1.1
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# The admin account. It is read from here only and never saved in the database.
# Log in with ADMIN_EMAIL (or ADMIN_PHONE) and ADMIN_PASSWORD.
# Change ADMIN_PASSWORD and restart the server to change the admin's password.
ADMIN_NAME=Sai Mess Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9000000001
ADMIN_PASSWORD=<choose a strong password>

# TESTING ONLY: true = orders can be added/removed on any day (past days too), with no cut-off times.
# Keep it false (or remove it) on the live site.
ALLOW_ANY_DAY=false
