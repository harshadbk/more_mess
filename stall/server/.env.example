MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=moremess
COLLECTION=stall_review
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=long-random-string
# Stall API port. The mess API uses 5001 (must match API_PROXY in ../.env).
PORT=5000
# Stall site origins allowed to call the API: dev (5173) and preview (4173).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
