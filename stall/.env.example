# Stall website (Vite). Copy to .env. No secrets go here.
# Mess uses 5174 / 4174 / 5001, so stall uses 5173 / 4173 / 5000.
DEV_PORT=5173
PREVIEW_PORT=4173
# Where Vite forwards /api in dev and preview: must match PORT in server/.env.
API_PROXY=http://localhost:5000

# Production only: the deployed stall API, e.g. https://api.shreesaisnacks.in (leave empty locally).
VITE_API_URL=
