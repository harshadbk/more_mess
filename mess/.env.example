# Mess website (Vite). Copy to .env. No secrets go here.
# Stall uses 5173 / 4173 / 5000, so mess uses 5174 / 4174 / 5001.
DEV_PORT=5174
PREVIEW_PORT=4174
# Where Vite forwards /api in dev and preview: must match PORT in backend/.env.
API_PROXY=http://localhost:5001

# Production only: the deployed mess API, e.g. https://api.saimess.in (leave empty locally).
VITE_API_URL=
